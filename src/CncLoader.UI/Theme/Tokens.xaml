<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== 颜色令牌（现代工业 HMI：石墨深色面 + teal 强调 + 状态色编码）=====
         资源键沿用旧名以兼容既有绑定（PlcRowVm.StatusBrushKey 等）。 -->
    <Color x:Key="ChromeColor">#11161C</Color>     <!-- 标题栏 / 导航 rail -->
    <Color x:Key="Chrome2Color">#222B34</Color>    <!-- 导航 hover / 选中 -->
    <Color x:Key="ChromeFgColor">#C7CDD4</Color>
    <Color x:Key="ChromeFgDimColor">#8B95A1</Color>
    <Color x:Key="BgColor">#0E1116</Color>
    <Color x:Key="SurfaceColor">#161B22</Color>
    <Color x:Key="Surface2Color">#1C232B</Color>
    <Color x:Key="BorderColor">#2A323B</Color>
    <Color x:Key="Border2Color">#222A32</Color>
    <Color x:Key="FgColor">#E6EAF0</Color>
    <Color x:Key="FgMutedColor">#8B95A1</Color>
    <Color x:Key="AccentColor">#16C2C7</Color>
    <Color x:Key="AccentDarkColor">#11A3A8</Color>
    <Color x:Key="AccentFgColor">#04201F</Color>     <!-- 强调按钮上的深色文字 -->
    <Color x:Key="OkColor">#22C55E</Color>
    <Color x:Key="RunColor">#3B82F6</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>
    <Color x:Key="AlarmColor">#EF4444</Color>
    <Color x:Key="NgColor">#F97316</Color>          <!-- NG 橙，与报警红区分（对齐原型） -->
    <Color x:Key="IdleColor">#6B7280</Color>
    <Color x:Key="TermColor">#0B0E12</Color>        <!-- 终端 / 流水背景 -->
    <!-- soft tint：对齐原型工位卡视觉重量（约 40% 状态色混 Surface） -->
    <Color x:Key="SoftRunColor">#2A4570</Color>
    <Color x:Key="SoftOkColor">#1F5540</Color>
    <Color x:Key="SoftAlarmColor">#5C2A32</Color>
    <Color x:Key="SoftWarnColor">#5A4628</Color>
    <Color x:Key="SoftNgColor">#6B3F24</Color>
    <Color x:Key="SoftIdleColor">#2E343C</Color>
    <Color x:Key="SoftOfflineColor">#2A3038</Color>
    <!-- 看板专用提亮色（仅监控看板；全局 Accent/Alarm 不变） -->
    <Color x:Key="DashAccentColor">#22D3D8</Color>
    <Color x:Key="DashAlarmColor">#F87171</Color>
    <Color x:Key="DashSurfaceColor">#1A222C</Color>       <!-- 比 Surface 略亮，拉开与 Bg 层次 -->
    <Color x:Key="DashSurface2Color">#232C38</Color>
    <Color x:Key="DashBorderColor">#3E4B5A</Color>        <!-- 更清晰描边，避免灰糊 -->
    <Color x:Key="DashIdleColor">#A8B4C2</Color>          <!-- 等待态图标/字，比 Idle 更亮 -->
    <Color x:Key="DashSoftIdleColor">#243040</Color>      <!-- 冷灰蓝底，替代脏灰 SoftIdle -->
    <Color x:Key="DashSoftOfflineColor">#1E2630</Color>

    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
    <SolidColorBrush x:Key="Chrome2Brush" Color="{StaticResource Chrome2Color}"/>
    <SolidColorBrush x:Key="ChromeFgBrush" Color="{StaticResource ChromeFgColor}"/>
    <SolidColorBrush x:Key="ChromeFgDimBrush" Color="{StaticResource ChromeFgDimColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Border2Brush" Color="{StaticResource Border2Color}"/>
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}"/>
    <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentFgBrush" Color="{StaticResource AccentFgColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="RunBrush" Color="{StaticResource RunColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="AlarmBrush" Color="{StaticResource AlarmColor}"/>
    <SolidColorBrush x:Key="NgBrush" Color="{StaticResource NgColor}"/>
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleColor}"/>
    <SolidColorBrush x:Key="TermBrush" Color="{StaticResource TermColor}"/>
    <SolidColorBrush x:Key="SoftRunBrush" Color="{StaticResource SoftRunColor}"/>
    <SolidColorBrush x:Key="SoftOkBrush" Color="{StaticResource SoftOkColor}"/>
    <SolidColorBrush x:Key="SoftAlarmBrush" Color="{StaticResource SoftAlarmColor}"/>
    <SolidColorBrush x:Key="SoftWarnBrush" Color="{StaticResource SoftWarnColor}"/>
    <SolidColorBrush x:Key="SoftNgBrush" Color="{StaticResource SoftNgColor}"/>
    <SolidColorBrush x:Key="SoftIdleBrush" Color="{StaticResource SoftIdleColor}"/>
    <SolidColorBrush x:Key="SoftOfflineBrush" Color="{StaticResource SoftOfflineColor}"/>
    <SolidColorBrush x:Key="DashAccentBrush" Color="{StaticResource DashAccentColor}"/>
    <SolidColorBrush x:Key="DashAlarmBrush" Color="{StaticResource DashAlarmColor}"/>
    <SolidColorBrush x:Key="DashSurfaceBrush" Color="{StaticResource DashSurfaceColor}"/>
    <SolidColorBrush x:Key="DashSurface2Brush" Color="{StaticResource DashSurface2Color}"/>
    <SolidColorBrush x:Key="DashBorderBrush" Color="{StaticResource DashBorderColor}"/>
    <SolidColorBrush x:Key="DashIdleBrush" Color="{StaticResource DashIdleColor}"/>
    <SolidColorBrush x:Key="DashSoftIdleBrush" Color="{StaticResource DashSoftIdleColor}"/>
    <SolidColorBrush x:Key="DashSoftOfflineBrush" Color="{StaticResource DashSoftOfflineColor}"/>

    <!-- ===== 形状/间距 ===== -->
    <CornerRadius x:Key="Radius">6</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>
    <sys:Double x:Key="RowHeight">34</sys:Double>

    <!-- ===== 字体 =====
         现代工业方向：Inter（界面）+ JetBrains Mono（机器数据），移除旧 Saira 标牌体。
         嵌入 .ttf 经 pack 引用；字形缺失时按逗号分隔列表 fallback 到 Microsoft YaHei UI 兜中文。
    -->
    <FontFamily x:Key="FontSans">pack://application:,,,/CncLoader.UI;component/Assets/Fonts/#Inter, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontCond">pack://application:,,,/CncLoader.UI;component/Assets/Fonts/#Inter, Microsoft YaHei UI, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/CncLoader.UI;component/Assets/Fonts/#JetBrains Mono, Consolas, Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
