<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== 颜色令牌（计量仪表盘：冷钢 + 仪器外框）===== -->
    <Color x:Key="ChromeColor">#191D22</Color>
    <Color x:Key="Chrome2Color">#232A31</Color>
    <Color x:Key="ChromeFgColor">#BFC6CE</Color>
    <Color x:Key="ChromeFgDimColor">#828B95</Color>
    <Color x:Key="BgColor">#E8EBEE</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#E9ECEF</Color>
    <Color x:Key="BorderColor">#CBD1D8</Color>
    <Color x:Key="Border2Color">#E1E5E9</Color>
    <Color x:Key="FgColor">#15181C</Color>
    <Color x:Key="FgMutedColor">#586069</Color>
    <Color x:Key="AccentColor">#135C96</Color>
    <Color x:Key="AccentDarkColor">#0E486F</Color>
    <Color x:Key="OkColor">#16A34A</Color>
    <Color x:Key="RunColor">#1F6FEB</Color>
    <Color x:Key="WarnColor">#C2710C</Color>
    <Color x:Key="AlarmColor">#D62828</Color>
    <Color x:Key="IdleColor">#6B7280</Color>

    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
    <SolidColorBrush x:Key="Chrome2Brush" Color="{StaticResource Chrome2Color}"/>
    <SolidColorBrush x:Key="ChromeFgBrush" Color="{StaticResource ChromeFgColor}"/>
    <SolidColorBrush x:Key="ChromeFgDimBrush" Color="{StaticResource ChromeFgDimColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Border2Brush" Color="{StaticResource Border2Color}"/>
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}"/>
    <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="RunBrush" Color="{StaticResource RunColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="AlarmBrush" Color="{StaticResource AlarmColor}"/>
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleColor}"/>

    <!-- ===== 形状/间距 ===== -->
    <CornerRadius x:Key="Radius">3</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">2</CornerRadius>
    <sys:Double x:Key="RowHeight">32</sys:Double>

    <!-- ===== 字体（Saira/Inter/JetBrains Mono 已作为 .ttf 资源打包，pack:// 引用，系统字体兜底）===== -->
    <FontFamily x:Key="FontSans">pack://application:,,,/CncLoader.UI;component/Assets/Fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="FontCond">pack://application:,,,/CncLoader.UI;component/Assets/Fonts/#Saira, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/CncLoader.UI;component/Assets/Fonts/#JetBrains Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
