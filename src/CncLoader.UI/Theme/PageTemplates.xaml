<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        页面模板聚合入口。每个 surface 一个字典，改一页只碰一个文件。

        注意：这里只放页面字典，不要把 SharedResources 挪进来。
        DataTemplate 内部的 StaticResource 只解析到 App 级字典这一层，
        嵌进本字典的子字典对模板内容不可见（模板实例化时会报「找不到资源 BrushConv」）。
        共享转换器/占位模板由 App.xaml 与 Tokens/Styles 同层合并。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/DashboardPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/WorkLinePage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/CraftworkPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/EquipmentPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/PlcPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/PointMappingPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/RcsPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/AgvPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/ScanPage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/FramePage.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Pages/LogPage.xaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
