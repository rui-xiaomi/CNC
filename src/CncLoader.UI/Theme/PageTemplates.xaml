<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:CncLoader.UI.ViewModels.Pages"
                    xmlns:conv="clr-namespace:CncLoader.UI.Converters">

    <!-- 计量"校准刻度"母题（签名元素，仅监控治具卡使用） -->
    <DrawingBrush x:Key="CalibrationTicks" TileMode="Tile" Stretch="None"
                  Viewport="0,0,11,7" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#1E6E70">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,1,7"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- PLC 页与点位映射页公用的局部转换器（重复声明，避免 DataTemplate 之间共享冲突） -->
    <conv:ResourceKeyToBrushConverter x:Key="BrushConv"/>
    <conv:BoolToOnOffConverter x:Key="PollConv"/>
    <conv:SemanticColorConverter x:Key="SemConv"/>
    <conv:BoolToYesNoConverter x:Key="YesNoConv"/>
    <conv:BoolToEnabledTextConverter x:Key="EnabledConv"/>
    <conv:BoolToStatusBrushConverter x:Key="StatusBrushConv"/>
    <conv:UploadRoleBrushConverter x:Key="RoleBrushConv"/>
    <conv:InverseBoolConverter x:Key="InverseConv"/>

    <!-- ===== 通用占位模板 ===== -->
    <DataTemplate x:Key="PlaceholderTemplate">
        <Grid Margin="2">
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" FontSize="16"/>
                    <Border Height="7" Margin="0,8,0,12" Background="{StaticResource CalibrationTicks}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
                    <TextBlock Text="将在后续阶段实现完整功能。" Style="{StaticResource MutedText}"
                               Margin="0,12,0,0" Opacity="0.8"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         AGV 管理（连通性测试，仅测试，按原型一比一）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:AgvViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Panel}" MaxWidth="700" HorizontalAlignment="Left" VerticalAlignment="Top">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="AGV 连通性测试" Style="{StaticResource PanelTitle}"/>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2"
                                    Padding="6,1" Margin="8,0,0,0" Background="{StaticResource SurfaceBrush}">
                                <TextBlock Text="仅测试，不纳入调度" Style="{StaticResource MutedText}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>

                    <!-- 表单 -->
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="名称" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="通信方式" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CommWayOptions}" SelectedItem="{Binding SelectedCommWay}"
                                      Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="地址" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="84,0,0,0">
                            <Button Content="测试连接" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseConv}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 测试结果 -->
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="测试结果" Style="{StaticResource PanelTitle}"/>
                            <Border BorderBrush="{Binding ResultBadgeBrushKey, Converter={StaticResource BrushConv}}"
                                    BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="8,0,0,0"
                                    Background="{StaticResource SurfaceBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                             Fill="{Binding ResultBadgeBrushKey, Converter={StaticResource BrushConv}}"/>
                                    <TextBlock Text="{Binding ResultBadgeText}" FontSize="12"
                                               Foreground="{Binding ResultBadgeBrushKey, Converter={StaticResource BrushConv}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Background="{StaticResource TermBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="10,8" Height="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TerminalLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource FontMono}"
                                                   FontSize="11" Foreground="#C7CDD4" LineHeight="18"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="24">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         扫码枪管理（连通性监听，仅测试，按原型一比一）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:ScanViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Panel}" MaxWidth="700" HorizontalAlignment="Left" VerticalAlignment="Top">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="扫码枪连通性测试" Style="{StaticResource PanelTitle}"/>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2"
                                    Padding="6,1" Margin="8,0,0,0" Background="{StaticResource SurfaceBrush}">
                                <TextBlock Text="仅测试，不纳入来料校验" Style="{StaticResource MutedText}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>

                    <!-- 表单 -->
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,12">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="模式" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                                      Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="监听端口" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="84,0,0,0">
                            <Button Content="开始监听" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartListenCommand}" IsEnabled="{Binding CanStart}"/>
                            <Button Content="停止" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding StopListenCommand}" IsEnabled="{Binding CanStop}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 连接 / 最近扫码 -->
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="连接 / 最近扫码" Style="{StaticResource PanelTitle}"/>
                            <Border BorderBrush="{Binding StatusBadgeBrushKey, Converter={StaticResource BrushConv}}"
                                    BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="8,0,0,0"
                                    Background="{StaticResource SurfaceBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                             Fill="{Binding StatusBadgeBrushKey, Converter={StaticResource BrushConv}}"/>
                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="12"
                                               Foreground="{Binding StatusBadgeBrushKey, Converter={StaticResource BrushConv}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding ScanRows}"
                              Style="{StaticResource DataGridCompact}" RowHeight="28" MaxHeight="220"
                              IsHitTestVisible="False" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="扫码内容" Binding="{Binding Content}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="24">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 启用/禁用 状态徽标（线体/工序/机台 列表共用） -->
    <DataTemplate x:Key="EnabledBadge">
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="6,1" HorizontalAlignment="Left" Margin="8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                         Fill="{Binding Enabled, Converter={StaticResource StatusBrushConv}}"/>
                <TextBlock Text="{Binding Enabled, Converter={StaticResource EnabledConv}}" FontSize="12"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         线体管理（左列表 + 右编辑表单，按原型一比一）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:WorkLineViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- 线体列表 -->
                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0" VerticalAlignment="Stretch">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="线体列表" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                            <Button Content="+ 新增线体" Style="{StaticResource PrimaryButton}" Padding="10,0"
                                    Height="24" FontSize="12" HorizontalAlignment="Right" Margin="12,0"
                                    Command="{Binding NewLineCommand}"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                  Style="{StaticResource DataGridCompact}" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="扫码枪" Binding="{Binding ScanEnabled, Converter={StaticResource YesNoConv}}" Width="64"/>
                                <DataGridTextColumn Header="AGV" Binding="{Binding AgvText}" Width="70"/>
                                <DataGridTemplateColumn Header="状态" Width="100" CellTemplate="{StaticResource EnabledBadge}"/>
                                <DataGridTemplateColumn Header="操作" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删除" Style="{StaticResource DangerButton}" Height="22"
                                                    Padding="8,0" FontSize="11" Margin="6,0"
                                                    Command="{Binding DataContext.DeleteLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- 编辑表单（撑满列高，与列表底部对齐；内容顶对齐，保存/取消按钮贴底） -->
                <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Stretch">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding EditTitle}" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,12">
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                        <StackPanel Margin="14,14,14,12" VerticalAlignment="Top">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="线体名称" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="线体编码" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="所在电脑" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding EditComputer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="电脑 IP" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding EditComputerIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="计划数量" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding EditPlanNum, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="扫码枪" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ScanOptions}" SelectedItem="{Binding SelectedScan}" Style="{StaticResource FormCombo}"/>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="24">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         工序管理（列表[按线体过滤] + 编辑表单，按原型一比一）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:CraftworkViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 工序列表 -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="工序列表" Style="{StaticResource PanelTitle}"/>
                            <ComboBox ItemsSource="{Binding LineFilters}" SelectedItem="{Binding SelectedLineFilter}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                                      Width="200" Height="26" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Content="+ 新增工序" Style="{StaticResource PrimaryButton}" Padding="10,0"
                                Height="24" FontSize="12" HorizontalAlignment="Right" Margin="12,0"
                                Command="{Binding NewCraftCommand}"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <DataGrid ItemsSource="{Binding Crafts}" SelectedItem="{Binding SelectedCraft}"
                              Style="{StaticResource DataGridCompact}" RowHeight="34" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="排序" Binding="{Binding Sort}" Width="56">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="编号" Binding="{Binding No}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110"/>
                            <DataGridTemplateColumn Header="类型" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Padding="6,1" HorizontalAlignment="Left" Margin="8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding TypeText}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="所属线体" Binding="{Binding LineName}" Width="*"/>
                            <DataGridTextColumn Header="自动发送" Binding="{Binding AutoSend, Converter={StaticResource YesNoConv}}" Width="80"/>
                            <DataGridTextColumn Header="优先级" Binding="{Binding Prior}" Width="64">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="状态" Width="110" CellTemplate="{StaticResource EnabledBadge}"/>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Style="{StaticResource DangerButton}" Height="22"
                                                Padding="8,0" FontSize="11" Margin="6,0"
                                                Command="{Binding DataContext.DeleteCraftCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 编辑表单 -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" MaxWidth="540" HorizontalAlignment="Left">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <TextBlock Text="{Binding EditTitle}" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <StackPanel Margin="14">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="所属线体" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LineOptions}" SelectedItem="{Binding SelectedEditLine}" DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="工序名称" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="工序类型" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" Style="{StaticResource FormCombo}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="工序排序" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding EditSort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="同序优先级" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding EditPrior, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="自动发送" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding YesNoOptions}" SelectedItem="{Binding SelectedAutoSend}" Style="{StaticResource FormCombo}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="84,0,0,0">
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="24">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         机台管理（列表[按工序过滤] + 加工位 + 关联料架，按原型一比一）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:EquipmentViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 机台列表 -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="机台列表" Style="{StaticResource PanelTitle}"/>
                            <ComboBox ItemsSource="{Binding CraftFilters}" SelectedItem="{Binding SelectedCraftFilter}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                                      Width="200" Height="26" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Content="+ 新增机台" Style="{StaticResource PrimaryButton}" Padding="10,0"
                                Height="24" FontSize="12" HorizontalAlignment="Right" Margin="12,0"
                                Command="{Binding AddEquipmentCommand}"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <DataGrid ItemsSource="{Binding Equipments}" SelectedItem="{Binding SelectedEquipment}"
                              Style="{StaticResource DataGridCompact}" RowHeight="34" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding No}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="80"/>
                            <DataGridTextColumn Header="所属工序" Binding="{Binding CraftName}" Width="100"/>
                            <DataGridTextColumn Header="所属 PLC" Binding="{Binding PlcText}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                                <DataGridTemplateColumn Header="状态" Width="110" CellTemplate="{StaticResource EnabledBadge}"/>
                                <DataGridTemplateColumn Header="操作" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                <Button Content="编辑" Style="{StaticResource GhostButton}" Height="22"
                                                        Padding="8,0" FontSize="11"
                                                        Command="{Binding DataContext.EditEquipmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="删除" Style="{StaticResource DangerButton}" Height="22"
                                                        Padding="8,0" FontSize="11" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DeleteEquipmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- 加工位 + 关联料架 -->
            <Grid Grid.Row="1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,7,0" VerticalAlignment="Top">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding PositionsTitle}" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding Positions}" Style="{StaticResource DataGridCompact}"
                                  RowHeight="32" IsHitTestVisible="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="状态" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                    Padding="6,1" HorizontalAlignment="Left" Margin="8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" Stroke="{StaticResource IdleBrush}" StrokeThickness="1.5"/>
                                                    <TextBlock Text="{Binding StateText}" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0" VerticalAlignment="Top">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="关联料架" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                            <Button Content="配置" Style="{StaticResource GhostButton}" Padding="10,0" Height="24"
                                    FontSize="12" HorizontalAlignment="Right" Margin="12,0"
                                    Command="{Binding ConfigureFrameCommand}"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <StackPanel Margin="14">
                            <ItemsControl ItemsSource="{Binding FrameBindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RoleText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                    Padding="8,2" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding IsUpload, Converter={StaticResource RoleBrushConv}}"/>
                                                    <TextBlock Text="{Binding FrameDisplay}" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="0,6,0,0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <TextBlock Text="机台新增时自动建 2 个加工位；点位映射在 PLC 管理页的「点位映射」tab 维护。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="24">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         料架管理（列表 + 绑定关系 + 槽位电极分层追踪 + 电极反查，按原型一比一）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:FrameViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 列表 + 绑定关系 -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,7,0" VerticalAlignment="Top">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="料架列表" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                            <Button Content="+ 新增" Style="{StaticResource PrimaryButton}" Padding="10,0" Height="24"
                                    FontSize="12" HorizontalAlignment="Right" Margin="12,0" Command="{Binding AddFrameCommand}"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                                  Style="{StaticResource DataGridCompact}" RowHeight="34" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="识别码" Binding="{Binding IdentifyCode}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="布局" Binding="{Binding LayoutText}" Width="64">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="槽位" Binding="{Binding SlotTotal}" Width="56">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="占用" Binding="{Binding Occupied}" Width="56">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0" VerticalAlignment="Top">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding BindingsTitle}" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding Bindings}" Style="{StaticResource DataGridCompact}"
                                  RowHeight="34" IsHitTestVisible="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="机台" Binding="{Binding EquipmentDisplay}" Width="*"/>
                                <DataGridTemplateColumn Header="角色" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                    Padding="6,1" HorizontalAlignment="Left" Margin="8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                             Fill="{Binding IsUpload, Converter={StaticResource RoleBrushConv}}"/>
                                                    <TextBlock Text="{Binding RoleText}" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 槽位与电极追踪 + 反查 -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <TextBlock Text="{Binding SlotsTitle}" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="电极反查" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ElectrodeQuery, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                     Height="26" FontSize="12" FontFamily="{StaticResource FontMono}" Margin="6,0,0,0"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="查询" Style="{StaticResource PrimaryButton}" Padding="12,0" Height="26"
                                    FontSize="12" Margin="6,0,0,0" Command="{Binding FindElectrodeCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <StackPanel Margin="14">
                        <ItemsControl ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Width="46" Height="46" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding LayerLabel}" Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="slot" Width="78" Height="46" Margin="0,0,8,0" CornerRadius="4"
                                                            BorderThickness="1" Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource FgMutedBrush}"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock x:Name="eid" Text="{Binding ElectrodeText}" FontFamily="{StaticResource FontMono}"
                                                                       FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Occupied}" Value="True">
                                                            <Setter TargetName="slot" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                            <Setter TargetName="slot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter TargetName="eid" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Occupied}" Value="False">
                                                            <Setter TargetName="eid" Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                            <Setter TargetName="slot" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                                            <Setter TargetName="slot" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="eid" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,2,0,0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{Binding FindResult}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         PLC 管理（按 docs/prototype/index.html 原型一比一还原）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:PlcViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── PLC 列表 ── -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <TextBlock Text="PLC 列表（一机一 PLC，IP 各异）"
                                   Style="{StaticResource PanelTitle}" Margin="12,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="12,0" VerticalAlignment="Center">
                            <Border BorderBrush="{StaticResource OkBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="6,1" Background="{StaticResource SurfaceBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding OnlineSummary}" Foreground="{StaticResource OkBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Button Content="全部连接" Style="{StaticResource GhostButton}" Padding="10,0"
                                    Height="24" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding ConnectAllCommand}"/>
                            <Button Content="全部断开" Style="{StaticResource GhostButton}" Padding="10,0"
                                    Height="24" FontSize="12" Margin="6,0,0,0"
                                    Command="{Binding DisconnectAllCommand}"/>
                            <Button Content="+ 新增 PLC" Style="{StaticResource PrimaryButton}" Padding="10,0"
                                    Height="24" FontSize="12" Margin="6,0,0,0"
                                    Command="{Binding AddPlcCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding PlcRows}" SelectedItem="{Binding SelectedPlc}"
                                  Style="{StaticResource DataGridCompact}" RowHeight="36" MaxHeight="240" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PLC" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="对应机台" Binding="{Binding EquipmentText}" Width="140"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="90"/>
                            <DataGridTemplateColumn Header="状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="2" Padding="6,1" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Margin="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                         Fill="{Binding StatusBrushKey, Converter={StaticResource BrushConv}}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="心跳" Binding="{Binding HeartbeatText}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                            <Button Content="连接" Style="{StaticResource GhostButton}" Height="22"
                                                    Padding="8,0" FontSize="11"
                                                    Command="{Binding DataContext.ConnectPlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="断开" Style="{StaticResource GhostButton}" Height="22"
                                                    Padding="8,0" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.DisconnectPlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="编辑" Style="{StaticResource GhostButton}" Height="22"
                                                    Padding="8,0" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.EditPlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource DangerButton}" Height="22"
                                                    Padding="8,0" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.DeletePlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── 读 / 写 / 点位映射（页内 tab，按原型一比一）── -->
            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <!-- 读操作 -->
                    <TabItem Header="读操作">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="40" Background="{StaticResource Surface2Brush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="点位实时值" Style="{StaticResource PanelTitle}"
                                           Margin="12,0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding EquipmentOptions}"
                                          SelectedItem="{Binding SelectedEquipment}" DisplayMemberPath="DisplayName"
                                          Style="{StaticResource FormCombo}" Width="200" Height="26"
                                          VerticalAlignment="Center" FontSize="12"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Button Content="单次读" Style="{StaticResource GhostButton}" Padding="12,0"
                                            Height="26" FontSize="12" Command="{Binding ReadOnceCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Padding="12,0" Height="26"
                                            FontSize="12" Margin="6,0,0,0" Command="{Binding TogglePollingCommand}">
                                        <TextBlock Text="{Binding IsPolling, Converter={StaticResource PollConv}}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                            <DataGrid ItemsSource="{Binding ReadRows}" Style="{StaticResource DataGridCompact}" RowHeight="28">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="信号" Binding="{Binding SignalLabel}" Width="120"/>
                                    <DataGridTextColumn Header="加工位" Binding="{Binding PositionName}" Width="80"/>
                                    <DataGridTextColumn Header="寄存器" Binding="{Binding RegisterAddress}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="原始" Binding="{Binding RawValue}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="语义" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SemanticText}" Margin="8,0"
                                                           Foreground="{Binding IsOn, Converter={StaticResource SemConv}}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- 写操作 -->
                    <TabItem Header="写操作">
                        <Grid Margin="14" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="320"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="信号" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,4,10,4"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding WriteSignals}"
                                              SelectedItem="{Binding SelectedWriteSignal}" DisplayMemberPath="DisplayName"
                                              Style="{StaticResource FormCombo}" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="写入值" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,4,10,4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WriteValueOptions}"
                                              SelectedItem="{Binding WriteValue}" Style="{StaticResource FormCombo}"
                                              FontFamily="{StaticResource FontMono}" Margin="0,4"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="76,0,0,0">
                                    <Button Content="下发（需确认）" Style="{StaticResource DangerButton}"
                                            Command="{Binding WriteSignalCommand}"/>
                                    <Button Content="回读校验" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Command="{Binding VerifyWriteCommand}"/>
                                </StackPanel>
                                <Border Margin="0,10,0,0" Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="写 PLC 会驱动真实机台动作，下发前二次确认（HandyControl Dialog）并记录操作人与流水。"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                            <DockPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock DockPanel.Dock="Top" Text="操作流水" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource TermBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Height="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding LogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource FontMono}"
                                                               FontSize="11" Foreground="#C7CDD4" LineHeight="18"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- 点位映射（按原型并入 PLC 页） -->
                    <TabItem Header="点位映射">
                        <ContentControl Content="{Binding PointMapping}"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ── 状态条 ── -->
            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="26">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         点位映射（MAS_AUTO_PLC_POINT 维护）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:PointMappingViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 过滤栏 -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,14">
                <Grid Height="44">
                    <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="PLC" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding PlcFilters}" SelectedItem="{Binding SelectedPlc}"
                                  DisplayMemberPath="Name" Style="{StaticResource FormCombo}"
                                  Width="180" Margin="8,0,0,0"/>
                        <TextBlock Text="机台" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <ComboBox ItemsSource="{Binding EquipmentOptions}" SelectedItem="{Binding SelectedEquipment}"
                                  DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                                  Width="200" Margin="8,0,0,0"/>
                        <Button Content="按信号表批量导入" Style="{StaticResource PrimaryButton}"
                                Padding="12,0" Margin="16,0,0,0"
                                Command="{Binding ImportSignalTableCommand}"/>
                        <Button Content="刷新" Style="{StaticResource GhostButton}"
                                Padding="12,0" Margin="8,0,0,0"
                                Command="{Binding ReloadPointsCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center">
                            <Run Text="共 "/><Run Text="{Binding TotalCount}" FontFamily="{StaticResource FontMono}"/><Run Text=" 个点位"/>
                        </TextBlock>
                        <Button Content="保存全部" Style="{StaticResource PrimaryButton}"
                                Padding="12,0" Margin="16,0,0,0"
                                Command="{Binding SaveAllCommand}"/>
                        <Button Content="保存所选" Style="{StaticResource GhostButton}"
                                Padding="12,0" Margin="8,0,0,0"
                                Command="{Binding SaveSelectedCommand}"/>
                        <Button Content="删除所选" Style="{StaticResource DangerButton}"
                                Padding="12,0" Margin="8,0,0,0"
                                Command="{Binding DeleteSelectedCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主表 -->
            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <TextBlock Text="点位列表（双击单元格可编辑；改多行用 保存全部，仅改当前行用 保存所选）"
                                   Style="{StaticResource PanelTitle}" Margin="12,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <DataGrid ItemsSource="{Binding PointRows}" SelectedItem="{Binding SelectedPoint}"
                              Style="{StaticResource DataGridCompact}" RowHeight="30" MaxHeight="360"
                              IsReadOnly="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="信号语义" Binding="{Binding SignalLabel}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="信号 KEY" Binding="{Binding SignalKey, UpdateSourceTrigger=PropertyChanged}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="加工位" Binding="{Binding PositionName}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="寄存器" Binding="{Binding RegisterAddress, UpdateSourceTrigger=PropertyChanged}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="IO 位" Binding="{Binding IoAddress, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="写" Binding="{Binding IsWrite}" Width="40"/>
                            <DataGridTextColumn Header="ON" Binding="{Binding OnValue, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="OFF" Binding="{Binding OffValue, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="长度" Binding="{Binding DataLength, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 状态条 -->
            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="24">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         监控看板（静态骨架，后续阶段接线实时数据）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:DashboardViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Panel}" Margin="0,0,6,0">
                    <StackPanel Margin="12">
                        <TextBlock Text="运行机台" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="3 / 3" FontFamily="{StaticResource FontMono}" FontSize="28"
                                   Foreground="{StaticResource RunBrush}"/>
                        <TextBlock Text="6 加工位（示例）" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="6,0,6,0">
                    <StackPanel Margin="12">
                        <TextBlock Text="当班 OK" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="1268" FontFamily="{StaticResource FontMono}" FontSize="28"
                                   Foreground="{StaticResource OkBrush}"/>
                        <TextBlock Text="示例数据" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="6,0,6,0">
                    <StackPanel Margin="12">
                        <TextBlock Text="当班 NG" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="22" FontFamily="{StaticResource FontMono}" FontSize="28"
                                   Foreground="{StaticResource AlarmBrush}"/>
                        <TextBlock Text="示例数据" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="6,0,0,0">
                    <StackPanel Margin="12">
                        <TextBlock Text="未处理告警" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="2" FontFamily="{StaticResource FontMono}" FontSize="28"
                                   Foreground="{StaticResource WarnBrush}"/>
                        <TextBlock Text="示例数据" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Height="34" Background="{StaticResource Surface2Brush}">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="内长宽" Style="{StaticResource PanelTitle}"/>
                                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="2"
                                            Margin="10,0,0,0" Padding="6,1">
                                        <TextBlock Text="EQ01" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="12,0" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="门 闭" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="安全" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="7" Background="{StaticResource CalibrationTicks}"
                                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border2Brush}"/>
                            <Grid Margin="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="工位1" Style="{StaticResource MutedText}" Width="46"/>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource RunBrush}"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="检测中" Style="{StaticResource BodyText}"/>
                                </StackPanel>
                                <TextBlock Text="OK 214 · NG 3（示例）" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Border2Brush}"/>
                            <Grid Margin="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="工位2" Style="{StaticResource MutedText}" Width="46"/>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="等待上料" Style="{StaticResource BodyText}"/>
                                </StackPanel>
                                <TextBlock Text="允许上料 ON（示例）" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="说明：监控看板为 Phase 1 静态骨架；实时状态由 PLC 信号经轮询中枢合成，将在后续阶段接线。"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="实时告警" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}"/>
                        <StackPanel Margin="12">
                            <TextBlock Text="告警列表将在异常处理阶段接线。"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
