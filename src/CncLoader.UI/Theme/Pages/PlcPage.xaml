<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:CncLoader.UI.ViewModels.Pages"
                    xmlns:conv="clr-namespace:CncLoader.UI.Converters">

    <!-- surface: view-plc（PLC 管理） -->
    <!-- ============================================================
         PLC 管理（按 docs/prototype/index.html 原型一比一还原）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:PlcViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── PLC 列表 ── -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <TextBlock Text="PLC 列表（一机一 PLC，IP 各异）"
                                   Style="{StaticResource PanelTitle}" Margin="12,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="12,0" VerticalAlignment="Center">
                            <!-- 模拟器红线横幅：Plc.UseSimulator=true 时醒目提示未驱动真机（P0-3） -->
                            <Border BorderBrush="{Binding PlcModeBrushKey, Converter={StaticResource BrushConv}}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}"
                                    ToolTip="{Binding PlcModeHint}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                             Fill="{Binding PlcModeBrushKey, Converter={StaticResource BrushConv}}"/>
                                    <TextBlock Text="{Binding PlcModeText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding PlcModeBrushKey, Converter={StaticResource BrushConv}}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource OkBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="6,1" Background="{StaticResource SurfaceBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding OnlineSummary}" Foreground="{StaticResource OkBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Button Content="全部连接" Style="{StaticResource GhostButton}" Padding="10,0"
                                    Height="24" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding ConnectAllCommand}"/>
                            <Button Content="全部断开" Style="{StaticResource GhostButton}" Padding="10,0"
                                    Height="24" FontSize="12" Margin="6,0,0,0"
                                    Command="{Binding DisconnectAllCommand}"/>
                            <Button Content="+ 新增 PLC" Style="{StaticResource PrimaryButton}" Padding="10,0"
                                    Height="24" FontSize="12" Margin="6,0,0,0"
                                    Command="{Binding AddPlcCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding PlcRows}" SelectedItem="{Binding SelectedPlc}"
                                  Style="{StaticResource DataGridCompact}" RowHeight="36" MaxHeight="240" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PLC" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="对应机台" Binding="{Binding EquipmentText}" Width="140"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="90"/>
                            <DataGridTemplateColumn Header="状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="2" Padding="6,1" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Margin="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                         Fill="{Binding StatusBrushKey, Converter={StaticResource BrushConv}}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="心跳" Binding="{Binding HeartbeatText}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="操作" Width="Auto" MinWidth="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                            <Button Content="连接" Style="{StaticResource GhostButton}" Height="22"
                                                    Padding="8,0" FontSize="11"
                                                    Command="{Binding DataContext.ConnectPlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="断开" Style="{StaticResource GhostButton}" Height="22"
                                                    Padding="8,0" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.DisconnectPlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="编辑" Style="{StaticResource GhostButton}" Height="22"
                                                    Padding="8,0" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.EditPlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource DangerButton}" Height="22"
                                                    Padding="8,0" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.DeletePlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── 读 / 写 / 点位映射（页内 tab，按原型一比一）── -->
            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <!-- 读操作 -->
                    <TabItem Header="读操作">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="40" Background="{StaticResource Surface2Brush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="点位实时值" Style="{StaticResource PanelTitle}"
                                           Margin="12,0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding EquipmentOptions}"
                                          SelectedItem="{Binding SelectedEquipment}" DisplayMemberPath="DisplayName"
                                          Style="{StaticResource FormCombo}" Width="200" Height="26"
                                          VerticalAlignment="Center" FontSize="12"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Button Content="单次读" Style="{StaticResource GhostButton}" Padding="12,0"
                                            Height="26" FontSize="12" Command="{Binding ReadOnceCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Padding="12,0" Height="26"
                                            FontSize="12" Margin="6,0,0,0" Command="{Binding TogglePollingCommand}">
                                        <TextBlock Text="{Binding IsPolling, Converter={StaticResource PollConv}}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                            <DataGrid ItemsSource="{Binding ReadRows}" Style="{StaticResource DataGridCompact}" RowHeight="28">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="信号" Binding="{Binding SignalLabel}" Width="120"/>
                                    <DataGridTextColumn Header="加工位" Binding="{Binding PositionName}" Width="80"/>
                                    <DataGridTextColumn Header="寄存器" Binding="{Binding RegisterAddress}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="原始" Binding="{Binding RawValue}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="语义" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SemanticText}" Margin="8,0"
                                                           Foreground="{Binding IsOn, Converter={StaticResource SemConv}}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- 写操作 -->
                    <TabItem Header="写操作">
                        <Grid Margin="14" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="320"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="信号" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,4,10,4"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding WriteSignals}"
                                              SelectedItem="{Binding SelectedWriteSignal}" DisplayMemberPath="DisplayName"
                                              Style="{StaticResource FormCombo}" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="写入值" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,4,10,4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WriteValueOptions}"
                                              SelectedItem="{Binding WriteValue}" Style="{StaticResource FormCombo}"
                                              FontFamily="{StaticResource FontMono}" Margin="0,4"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="76,0,0,0">
                                    <Button Content="下发（需确认）" Style="{StaticResource DangerButton}"
                                            Command="{Binding WriteSignalCommand}"/>
                                    <Button Content="回读校验" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Command="{Binding VerifyWriteCommand}"/>
                                </StackPanel>
                                <Border Margin="0,10,0,0" Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="写 PLC 会驱动真实机台动作，下发前二次确认（HandyControl Dialog）并记录操作人与流水。"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                            <DockPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock DockPanel.Dock="Top" Text="操作流水" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource TermBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Height="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding LogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource FontMono}"
                                                               FontSize="11" Foreground="{StaticResource ChromeFgBrush}" LineHeight="18"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- 点位映射（按原型并入 PLC 页） -->
                    <TabItem Header="点位映射">
                        <ContentControl Content="{Binding PointMapping}"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ── 状态条 ── -->
            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="26">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
