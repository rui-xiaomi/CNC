<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:CncLoader.UI.ViewModels.Pages"
                    xmlns:conv="clr-namespace:CncLoader.UI.Converters">

    <!-- surface: view-log（日志/告警） -->
    <!-- ============================================================
         日志/告警页（TabControl：告警明细 + 应用运行日志）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:LogViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0"
                            SelectedIndex="{Binding SelectedTabIndex}">
                    <!-- 告警明细 -->
                    <TabItem Header="告警明细">
                        <DockPanel Margin="14">
                            <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Surface2Brush}">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <CheckBox Content="只看未处理" IsChecked="{Binding UnhandledOnly}"
                                              Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"
                                              ToolTip="勾选后仅显示未确认告警"/>
                                    <TextBlock Text="条数" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <ComboBox ItemsSource="{Binding AlarmCountOptions}" SelectedItem="{Binding AlarmCount}"
                                              Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}"
                                              Width="72" Height="26" Margin="6,0,0,0"/>
                                    <Button Content="刷新" Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                            Margin="12,0,0,0" Command="{Binding RefreshAlarmsCommand}"/>
                                    <Button Content="标记已处理" Style="{StaticResource PrimaryButton}" Height="26" Padding="12,0"
                                            Margin="8,0,0,0" Command="{Binding MarkHandledCommand}"
                                            ToolTip="将当前选中行标记为已处理"/>
                                    <Button Content="全部确认" Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                            Margin="8,0,0,0" Command="{Binding MarkAllHandledCommand}"
                                            ToolTip="确认库内全部未处理告警"/>
                                    <Button Content="全部删除" Style="{StaticResource DangerButton}" Height="26" Padding="12,0"
                                            Margin="8,0,0,0" Command="{Binding DeleteAllAlarmsCommand}"
                                            ToolTip="物理删除全部告警，不可恢复"/>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding AlarmsEmpty, Converter={StaticResource BoolVisConv}}"/>
                                <DataGrid ItemsSource="{Binding Alarms}" SelectedItem="{Binding SelectedAlarm}"
                                          Style="{StaticResource DataGridCompact}" RowHeight="30"
                                          Visibility="{Binding AlarmsEmpty, Converter={StaticResource BoolVisInvConv}}">
                                    <DataGrid.Columns>
                                        <!-- yyyy-MM-dd HH:mm:ss 等宽约需 180；过窄会截成 15:24.. -->
                                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                            Width="186" MinWidth="180" SortMemberPath="Time">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0,8,0"/>
                                                    <Setter Property="TextTrimming" Value="None"/>
                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                    <Setter Property="ToolTip" Value="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="级别" Width="64" SortMemberPath="Level" CanUserSort="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Level}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Foreground="{Binding Level, Converter={StaticResource AlarmLevelBrushConv}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类型" Binding="{Binding AlarmType}" Width="100" MinWidth="88"
                                                            SortMemberPath="AlarmType">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsisMono}">
                                                    <Setter Property="ToolTip" Value="{Binding AlarmType}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" MinWidth="160"
                                                            SortMemberPath="Message">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsis}">
                                                    <Setter Property="ToolTip" Value="{Binding Message}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="状态" Width="108" MinWidth="100"
                                                                SortMemberPath="State" CanUserSort="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="3" Padding="8,2" Margin="8,0,10,0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                     Fill="{Binding State, Converter={StaticResource AlarmStateBrushConv}}"/>
                                                            <TextBlock Text="{Binding State}" FontSize="12"
                                                                       TextTrimming="None" TextWrapping="NoWrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <!-- 应用运行日志 -->
                    <TabItem Header="应用日志">
                        <DockPanel Margin="14">
                            <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Surface2Brush}">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="级别" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedLevel}"
                                              Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}"
                                              Width="90" Height="26" Margin="6,0,0,0"/>
                                    <TextBlock Text="行数" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <ComboBox ItemsSource="{Binding LineCountOptions}" SelectedItem="{Binding LineCount}"
                                              Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}"
                                              Width="80" Height="26" Margin="6,0,0,0"/>
                                    <Button Content="刷新" Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                            Margin="12,0,0,0" Command="{Binding RefreshLogCommand}"/>
                                    <TextBlock Text="读当天 logs 文件尾部" Style="{StaticResource MutedText}" FontSize="11"
                                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="暂无应用日志" Style="{StaticResource MutedText}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding LogsEmpty, Converter={StaticResource BoolVisConv}}"/>
                                <DataGrid ItemsSource="{Binding LogLines}" Style="{StaticResource DataGridCompact}"
                                          RowHeight="26" IsReadOnly="True"
                                          Visibility="{Binding LogsEmpty, Converter={StaticResource BoolVisInvConv}}">
                                    <DataGrid.Columns>
                                        <!-- 模板列 + 固定宽，避免 HC DataGrid 单元格把 HH:mm:ss.fff 裁成 16:18:13.1... -->
                                        <DataGridTemplateColumn Header="时间" Width="150" MinWidth="150"
                                                                SortMemberPath="Time" CanUserSort="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss.fff}"
                                                               FontFamily="{StaticResource FontMono}"
                                                               VerticalAlignment="Center" Margin="10,0,8,0"
                                                               TextTrimming="None" TextWrapping="NoWrap"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="级别" Width="64" MinWidth="56"
                                                                SortMemberPath="Level" CanUserSort="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Level}" FontFamily="{StaticResource FontMono}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               TextTrimming="None" TextWrapping="NoWrap"
                                                               Foreground="{Binding Level, Converter={StaticResource AlarmLevelBrushConv}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="内容" Binding="{Binding Text}" Width="*" MinWidth="160"
                                                            SortMemberPath="Text">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsisMono}">
                                                    <Setter Property="ToolTip" Value="{Binding Text}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="26">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
