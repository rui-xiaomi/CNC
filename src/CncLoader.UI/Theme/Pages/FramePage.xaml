<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:CncLoader.UI.ViewModels.Pages"
                    xmlns:conv="clr-namespace:CncLoader.UI.Converters">

    <!-- surface: view-frame（料架管理） -->
    <!-- ============================================================
         料架管理（列表 + 绑定关系 + 槽位电极分层追踪 + 电极反查，按原型一比一）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:FrameViewModel}">
        <!-- 左右分栏：左=列表+绑定，右=槽位+底栏操作，避免纵向挤压 -->
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：料架列表 + 绑定 -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="*" MinHeight="160"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <DockPanel>
                        <!-- 按钮先 Dock 右侧，保证「删」不被裁切；标题占剩余宽度可省略 -->
                        <DockPanel DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <CheckBox Content="仅NG" IsChecked="{Binding ShowNgOnly}" VerticalAlignment="Center"
                                          Margin="0,0,6,0" ToolTip="只显示绑定了 NG 角色的料架"/>
                                <Button Content="+" Style="{StaticResource PrimaryButton}" Padding="8,0" Height="24"
                                        FontSize="12" Command="{Binding AddFrameCommand}" ToolTip="新增料架"/>
                                <Button Content="编辑" Style="{StaticResource GhostButton}" Padding="8,0" Height="24"
                                        FontSize="12" Margin="4,0,0,0" Command="{Binding EditFrameCommand}"/>
                                <Button Content="删除" Style="{StaticResource DangerButton}" Padding="8,0" Height="24"
                                        FontSize="12" Margin="4,0,0,0" Command="{Binding DeleteFrameCommand}"/>
                            </StackPanel>
                            <TextBlock Text="料架列表" Style="{StaticResource PanelTitle}" Margin="12,0,8,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                                  Style="{StaticResource DataGridCompact}" RowHeight="32" Margin="0,0,4,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsis}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="布局" Binding="{Binding LayoutText}" Width="56">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="占用" Binding="{Binding Occupied}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding BindingsTitle}" Style="{StaticResource PanelTitle}" Margin="12,0"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <TextBlock DockPanel.Dock="Top" Margin="10,6,10,0" TextWrapping="Wrap"
                                   Text="名称≠角色：选机台+角色后点绑定。同一架可绑多台机；一台机同一角色只能绑一架。"
                                   Style="{StaticResource MutedText}" FontSize="11"/>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" Padding="8,6" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="机台" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding EquipmentOptions}" SelectedItem="{Binding SelectedBindEquipment}"
                                          DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                                          Foreground="{StaticResource FgBrush}" Height="26" Margin="0,0,0,6"/>
                                <TextBlock Text="对本机角色" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding BindRoleOptions}" SelectedItem="{Binding SelectedBindRole}"
                                              DisplayMemberPath="Label" Style="{StaticResource FormCombo}"
                                              Foreground="{StaticResource FgBrush}" Width="110" Height="26"/>
                                    <Button Content="绑定" Style="{StaticResource PrimaryButton}" Height="26" Padding="12,0"
                                            Margin="8,0,0,0" Command="{Binding BindEquipmentCommand}"
                                            ToolTip="把当前料架绑到所选机台的该角色（会顶掉该机台该角色的旧绑定）"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                        <DataGrid ItemsSource="{Binding Bindings}" Style="{StaticResource DataGridCompact}" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="机台 · 角色" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding IsUpload, Converter={StaticResource RoleBrushConv}}"/>
                                                <TextBlock Text="{Binding BindingText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding BindingText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="解绑" Style="{StaticResource DangerButton}" Height="22" Padding="6,0"
                                                    FontSize="11" Margin="4,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.UnbindCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右栏：槽位网格 + 底栏校正/盘点 -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Surface2Brush}">
                        <TextBlock Text="{Binding SlotsTitle}" Style="{StaticResource PanelTitle}" Margin="12,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="物料反查" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaterialQuery, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                     Height="26" FontSize="12" FontFamily="{StaticResource FontMono}" Margin="6,0,0,0"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="查询" Style="{StaticResource PrimaryButton}" Padding="12,0" Height="26"
                                    FontSize="12" Margin="6,0,0,0" Command="{Binding FindMaterialCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                    <!-- 统计 / 反查结果：独立一行，不挤盘点操作 -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" Padding="12,6">
                        <TextBlock Text="{Binding FindResult}" Style="{StaticResource MutedText}" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>

                    <!-- 底栏：校正 + 盘点（单行；右侧按钮固定） -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource Surface2Brush}" Padding="12,10" ClipToBounds="False">
                        <StackPanel>
                            <TextBlock Text="人工校正 / NG 闭环"
                                       Style="{StaticResource PanelTitle}" FontSize="13" Margin="0,0,0,6"/>
                            <DockPanel LastChildFill="True" Margin="0,0,0,10" MinHeight="32">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="置空释放" Style="{StaticResource DangerButton}" Height="32" Padding="12,0"
                                            FontSize="13" Margin="0,0,6,0" Command="{Binding ClearSelectedSlotCommand}"/>
                                    <Button Content="校正保存" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0"
                                            FontSize="13" Command="{Binding CorrectSlotCommand}"/>
                                </StackPanel>
                                <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="48"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="选中" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSlot.Label, TargetNullValue='—'}"
                                               FontFamily="{StaticResource FontMono}" FontSize="13" VerticalAlignment="Center"
                                               MinWidth="56" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="物料" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding CorrectMaterial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                             FontFamily="{StaticResource FontMono}" FontSize="13" Height="32" Margin="0,0,8,0"
                                             VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Column="4" ItemsSource="{Binding SlotStateOptions}" SelectedItem="{Binding CorrectSlotState}"
                                              Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}"
                                              Width="96" Height="32" FontSize="12"/>
                                </Grid>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                            <DockPanel LastChildFill="False" MinHeight="32">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="盘点" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="起始" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding InventoryPosStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                             FontFamily="{StaticResource FontMono}" FontSize="13" Width="64" Height="32" Margin="0,0,10,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="数量" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding InventoryCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                             FontFamily="{StaticResource FontMono}" FontSize="13" Width="48" Height="32" Margin="0,0,10,0"
                                             VerticalContentAlignment="Center"/>
                                    <Button Content="发起盘点" Style="{StaticResource PrimaryButton}"
                                            Height="32" Padding="14,0" FontSize="13"
                                            Command="{Binding StartInventoryCommand}" ToolTip="下发 identifyQR，约 3~4 分钟后回调自动校正槽位"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 槽位网格贴顶，少留白 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Layers}" Margin="16,12,16,8"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Width="46" Height="46" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding LayerLabel}" Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="78" Height="46" Margin="0,0,8,0" Cursor="Hand" Padding="0" BorderThickness="1"
                                                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="slot" Width="78" Height="46" CornerRadius="4" BorderThickness="1"
                                                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource FgMutedBrush}"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <TextBlock x:Name="eid" Text="{Binding MaterialText}" FontFamily="{StaticResource FontMono}"
                                                                                   FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="slot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Occupied}" Value="True">
                                                                        <Setter TargetName="slot" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                                        <Setter TargetName="slot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                        <Setter TargetName="eid" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Reserved}" Value="True">
                                                                        <Setter TargetName="slot" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                                        <Setter TargetName="slot" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                                                        <Setter TargetName="eid" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                        <Setter TargetName="slot" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                                                        <Setter TargetName="slot" Property="BorderThickness" Value="2"/>
                                                                        <Setter TargetName="eid" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
