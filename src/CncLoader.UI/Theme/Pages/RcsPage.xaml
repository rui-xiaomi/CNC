<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:CncLoader.UI.ViewModels.Pages"
                    xmlns:conv="clr-namespace:CncLoader.UI.Converters">

    <!-- surface: view-rcs（RCS 任务） -->
    <!-- ============================================================
         RCS 任务管理（第四阶段①骨架：连接/下发/任务/报文/位置映射）
         ============================================================ -->
    <DataTemplate DataType="{x:Type p:RcsViewModel}">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <TabControl SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0">
                    <!-- 连接 & 下发 -->
                    <TabItem Header="任务列表">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="40" Background="{StaticResource Surface2Brush}">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="RCS 任务" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="点选一行可回填任务号，供取消 / 重试 / 确认取消" Style="{StaticResource MutedText}"
                                               FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="刷新" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,0,12,0"
                                        Height="26" Padding="12,0" FontSize="12" Command="{Binding RefreshTasksCommand}"/>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>
                            <DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                      Style="{StaticResource DataGridCompact}" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="任务号" Binding="{Binding RcsTaskId}" Width="280" MinWidth="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsisMono}">
                                                <Setter Property="ToolTip" Value="{Binding RcsTaskId}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="种类" Binding="{Binding Kind, Converter={StaticResource RcsKindZhConv}}" Width="72" MinWidth="56"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding TaskState, Converter={StaticResource RcsStateZhConv}}" Width="72" MinWidth="56"/>
                                    <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="80" MinWidth="72"/>
                                    <DataGridTextColumn Header="起点" Binding="{Binding FromCode}" Width="100" MinWidth="80"/>
                                    <DataGridTextColumn Header="终点" Binding="{Binding ToCode}" Width="100" MinWidth="80"/>
                                    <DataGridTextColumn Header="重试次数" Binding="{Binding RedoCount}" Width="100" MinWidth="96"/>
                                    <DataGridTextColumn Header="创建时间" Binding="{Binding SendTime, StringFormat=HH:mm:ss}" Width="88" MinWidth="80"/>
                                    <DataGridTemplateColumn Header="取消处理" Width="96" MinWidth="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource CancelFlagConv}">
                                                            <Binding Path="TaskState"/>
                                                            <Binding Path="CancelManualFlag"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="错误" Binding="{Binding ErrorMsg}" Width="*" MinWidth="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsis}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- 报文流水 -->
                    <TabItem Header="报文流水">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" LastChildFill="False">
                                <TextBlock Text="RCS 双向报文" Style="{StaticResource PanelTitle}" Margin="12,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,6,12,6">
                                    <TextBlock Text="任务号" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Width="160" Text="{Binding MsgFilterTaskId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                             FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"
                                             ToolTip="模糊匹配任务号"/>
                                    <TextBlock Text="方向" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <ComboBox Width="72" ItemsSource="{Binding MsgDirectionOptions}" SelectedItem="{Binding MsgFilterDirection}"
                                              Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="接口" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <ComboBox Width="100" ItemsSource="{Binding MsgInterfaceOptions}" SelectedItem="{Binding MsgFilterInterface}"
                                              Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="条数" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <ComboBox Width="72" ItemsSource="{Binding MsgLimitOptions}" SelectedItem="{Binding MsgLimit}"
                                              Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                    <Button Content="查询" Style="{StaticResource GhostButton}" Height="26" Padding="12,0" FontSize="12"
                                            Margin="8,0,0,0" Command="{Binding RefreshMessagesCommand}"/>
                                    <CheckBox Content="自动刷新" IsChecked="{Binding AutoRefreshMessages}" Foreground="{StaticResource FgBrush}"
                                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}"/>

                            <!-- 选中行详情：完整请求/响应 -->
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Background="{StaticResource Surface2Brush}" Padding="12,8" MinHeight="140" MaxHeight="220">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0">
                                        <TextBlock DockPanel.Dock="Top" Text="请求体" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding SelectedMessage.RequestBody, Converter={StaticResource PrettyJsonConv}, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                                                     Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource FontMono}" FontSize="11"
                                                     AcceptsReturn="True"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock DockPanel.Dock="Top" Text="响应体" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding SelectedMessage.ResponseBody, Converter={StaticResource PrettyJsonConv}, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                                                     Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource FontMono}" FontSize="11"
                                                     AcceptsReturn="True"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <DataGrid ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                                      Style="{StaticResource DataGridCompact}" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="80" MinWidth="72"/>
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction, Converter={StaticResource RcsDirZhConv}}" Width="56" MinWidth="48"/>
                                    <DataGridTextColumn Header="接口" Binding="{Binding Interface, Converter={StaticResource RcsIfaceZhConv}}" Width="88" MinWidth="80"/>
                                    <DataGridTextColumn Header="任务号" Binding="{Binding TaskId}" Width="240" MinWidth="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsisMono}">
                                                <Setter Property="ToolTip" Value="{Binding TaskId}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="结果" Binding="{Binding Success, Converter={StaticResource RcsResultZhConv}}" Width="56" MinWidth="48"/>
                                    <DataGridTextColumn Header="耗时" Binding="{Binding CostMs, Converter={StaticResource RcsCostZhConv}}" Width="72" MinWidth="64"/>
                                    <DataGridTextColumn Header="摘要" Binding="{Binding RequestBody}" Width="*" MinWidth="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsisMono}">
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="ToolTip" Value="{Binding RequestBody}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="120" MinWidth="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsis}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- 连接 & 下发 -->
                    <TabItem Header="连接 &amp; 下发">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="380"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 连接配置（可编辑，落库） -->
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- 标题+状态一行；按钮单独一行，避免窄栏裁切「保存」 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="RCS 连接配置" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                                                <Border Margin="10,0,0,0" BorderBrush="{Binding RcsModeBrushKey, Converter={StaticResource BrushConv}}"
                                                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        ToolTip="{Binding RcsModeHint}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                                 Fill="{Binding RcsModeBrushKey, Converter={StaticResource BrushConv}}"/>
                                                        <TextBlock Text="{Binding RcsModeText}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding RcsModeBrushKey, Converter={StaticResource BrushConv}}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="8,0,0,0" BorderBrush="{Binding ConnectionHealthBrushKey, Converter={StaticResource BrushConv}}"
                                                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                        ToolTip="出站：客户端 → RCS">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                                 Fill="{Binding ConnectionHealthBrushKey, Converter={StaticResource BrushConv}}"/>
                                                        <TextBlock Text="{Binding ConnectionHealthText}" FontSize="11"
                                                                   Foreground="{Binding ConnectionHealthBrushKey, Converter={StaticResource BrushConv}}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="8,0,0,0" BorderBrush="{Binding CallbackHealthBrushKey, Converter={StaticResource BrushConv}}"
                                                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                        ToolTip="仅测本机 Kestrel 回调口；不代表 RCS→工控机网络已通">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                                 Fill="{Binding CallbackHealthBrushKey, Converter={StaticResource BrushConv}}"/>
                                                        <TextBlock Text="{Binding CallbackHealthText}" FontSize="11"
                                                                   Foreground="{Binding CallbackHealthBrushKey, Converter={StaticResource BrushConv}}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <Button Content="测试连接" Style="{StaticResource GhostButton}" Height="26" Padding="12,0" FontSize="12"
                                                            Margin="0,0,8,0" Command="{Binding TestConnectionCommand}"
                                                            IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseConv}}"
                                                            ToolTip="向 RCS 发 queryTask，验证出站连通"/>
                                                    <Button Content="测试本机监听" Style="{StaticResource GhostButton}" Height="26" Padding="12,0" FontSize="12"
                                                            Margin="0,0,8,0" Command="{Binding TestCallbackCommand}"
                                                            IsEnabled="{Binding IsTestingCallback, Converter={StaticResource InverseConv}}"
                                                            ToolTip="对本机回调口 POST 探针：只能证明本机 Kestrel 正常，不代表 RCS 服务器→工控机回调端口网络已打通"/>
                                                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Height="26" Padding="14,0" FontSize="12"
                                                            Command="{Binding SaveConnectionCommand}"
                                                            IsEnabled="{Binding IsSavingConnection, Converter={StaticResource InverseConv}}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="11" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"
                                                           Foreground="{Binding RcsModeBrushKey, Converter={StaticResource BrushConv}}"
                                                           TextWrapping="Wrap" Margin="0,0,10,0"
                                                           Text="{Binding EffectiveBaseUrl, StringFormat=生效 BaseUrl：{0}}"/>
                                            </DockPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/><ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="地址" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}" Margin="0,0,10,0" ToolTip="RCS 出站基址，如 http://127.0.0.1:8090"/>
                                                <TextBlock Grid.Column="2" Text="clientCode" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="3" Text="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/><ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="48"/><ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="40"/><ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="40"/><ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="回调" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding CallbackHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}" Margin="0,0,6,0" ToolTip="本机回调监听 IP"/>
                                                <TextBlock Grid.Column="2" Text="端口" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="3" Text="{Binding CallbackPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="4" Text="超时" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="5" Text="{Binding RequestTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}" Margin="0,0,8,0" ToolTip="出站超时（毫秒）"/>
                                                <TextBlock Grid.Column="6" Text="重试" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="7" Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="8" Text="轮询" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="9" Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}" ToolTip="兜底轮询间隔（毫秒）"/>
                                            </Grid>
                                            <TextBlock Text="出站地址/超时/重试/轮询保存后立即生效；回调 Host/Port 变更需重启客户端。"
                                                       Style="{StaticResource MutedText}" FontSize="10" Opacity="0.85" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 手动下发 -->
                                    <TextBlock Text="手动下发" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox Content="暂停自动派工 / 仅手动测试"
                                                      IsChecked="{Binding PauseAutoDispatch}"
                                                      Foreground="{StaticResource FgBrush}" FontSize="12"
                                                      ToolTip="开启后 PositionScheduler 不再产生或下发新的自动上料/下料任务；本页手工下发仍可用；已下发任务继续跟踪与安全收口"/>
                                            <TextBlock Text="{Binding AutoDispatchStatusText}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{Binding AutoDispatchStatusBrushKey, Converter={StaticResource BrushConv}}"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/><ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="类型" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                                                  Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="优先级" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"
                                                 ToolTip="协议范围 1～10，大者优先"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FromLabelText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding FromCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"
                                                 ToolTip="可直接填现场 RCS cell 编码；不强制 LOCATION_MAP"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" Visibility="{Binding ShowToCode, Converter={StaticResource BoolVisConv}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ToLabelText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding ToCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"
                                                 ToolTip="可直接填现场 RCS cell 编码；不强制 LOCATION_MAP"/>
                                    </Grid>

                                    <!-- 抓取参数（仅抓取时显示） -->
                                    <Border Margin="0,0,0,8" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8"
                                            Visibility="{Binding ShowGrabParams, Converter={StaticResource BoolVisConv}}">
                                        <StackPanel>
                                            <TextBlock Text="抓取孔位" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="源架号" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SrcNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <TextBlock Text="源孔位" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SrcPos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                                    <TextBlock Text="目标架" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding DstNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                                    <TextBlock Text="目标孔" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding DstPos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="电极码" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding GrabData, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 识别参数（仅识别时显示） -->
                                    <Border Margin="0,0,0,8" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8"
                                            Visibility="{Binding ShowIdentifyParams, Converter={StaticResource BoolVisConv}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/><ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="起始孔" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding PosStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"
                                                     Margin="0,0,10,0" ToolTip="三位数孔位，如 101=1层1位"/>
                                            <TextBlock Grid.Column="2" Text="数量" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="3" Text="{Binding IdentifyCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="下发" Style="{StaticResource PrimaryButton}" Command="{Binding DispatchCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseConv}}"
                                                ToolTip="真实 RCS 须先测试连接；点到点手工任务不联动 PLC / 槽位账"/>
                                        <Button Content="查询任务" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding QueryCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DispatchGateHint}" FontSize="11"
                                               Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <!-- 任务操作 -->
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="任务操作" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="任务号" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding OperateTaskId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"
                                                         ToolTip="可从任务列表点选回填"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="重试" Style="{StaticResource GhostButton}" Command="{Binding RedoCommand}"
                                                        ToolTip="失败后同任务号重发（RCS redo）"/>
                                                <Button Content="取消任务" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding CancelCommand}"/>
                                                <Button Content="确认取消已处理" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                        Command="{Binding ConfirmCancelHandledCommand}" ToolTip="取消后人工处理完小车/容器，标记已处理"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 换架 / 空托盘回收 -->
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="换架 / 空托盘回收（手动触发）" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBlock Text="调试与应急用：换架=先拉旧架再送新架；空托回收=指定点位运到托盘回收区。正式运行可由水位监视自动换架。"
                                                       Style="{StaticResource MutedText}" FontSize="10" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/><ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="40"/><ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="机台ID" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding ChangeFrameEquipmentId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="角色" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="3" ItemsSource="{Binding ChangeFrameRoleOptions}" SelectedItem="{Binding ChangeFrameRole}"
                                                          Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="4" Content="换架" Style="{StaticResource PrimaryButton}" Height="26" Padding="12,0" Command="{Binding ChangeFrameCommand}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="回收点位" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding PalletReturnFromCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"
                                                         FontFamily="{StaticResource FontMono}" Width="100" Margin="0,0,8,0"/>
                                                <Button Content="空托回收" Style="{StaticResource GhostButton}" Height="26" Padding="12,0" Command="{Binding PalletReturnCommand}"
                                                        ToolTip="点位 → 托盘回收区"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 换架事务 -->
                                    <TextBlock Text="换架事务" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                                    <DataGrid ItemsSource="{Binding ChangeFrameTransactions}" Style="{StaticResource DataGridCompact}" RowHeight="26"
                                              MaxHeight="140" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="事务号" Binding="{Binding TxnId}" Width="200" MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsisMono}">
                                                        <Setter Property="ToolTip" Value="{Binding TxnId}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="机台" Binding="{Binding EquipmentId}" Width="48" MinWidth="40"/>
                                            <DataGridTextColumn Header="角色" Binding="{Binding Role, Converter={StaticResource FrameRoleZhConv}}" Width="72" MinWidth="64"/>
                                            <DataGridTextColumn Header="步骤" Binding="{Binding Step, Converter={StaticResource CfStepZhConv}}" Width="72" MinWidth="64"/>
                                            <DataGridTextColumn Header="状态" Binding="{Binding State, Converter={StaticResource RcsStateZhConv}}" Width="72" MinWidth="64"/>
                                            <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" MinWidth="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellEllipsis}">
                                                        <Setter Property="ToolTip" Value="{Binding Message}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 右：调用终端（撑满高度） -->
                            <DockPanel Grid.Column="2">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                    <TextBlock Text="调用终端" Style="{StaticResource MutedText}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="清空" Style="{StaticResource GhostButton}" Height="24" Padding="10,0" FontSize="11"
                                            DockPanel.Dock="Right" Command="{Binding ClearTerminalCommand}"/>
                                </DockPanel>
                                <Border Background="{StaticResource TermBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" conv:AutoScroll.ToEnd="True">
                                        <ItemsControl ItemsSource="{Binding TerminalLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource ChromeFgBrush}" LineHeight="18"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- 位置映射 -->
                    <TabItem Header="位置映射">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="420"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="320" MinWidth="280"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <TextBlock Text="位置映射" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LocationCountText}" Style="{StaticResource MutedText}" FontSize="11"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="逻辑位置 ↔ RCS 点位；调度/换架/盘点靠此表翻译。"
                                                   Style="{StaticResource MutedText}" FontSize="10" Opacity="0.85"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="类型" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding LocFilterTypeOptions}" SelectedItem="{Binding LocFilterType}"
                                                  Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}"
                                                  Width="88" Height="26" Margin="0,0,8,0"/>
                                        <Button Content="刷新" Style="{StaticResource GhostButton}" Height="26" Padding="12,0" FontSize="12"
                                                Command="{Binding RefreshLocationsCommand}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding FilteredLocations}" SelectedItem="{Binding SelectedLocation}"
                                          Style="{StaticResource DataGridCompact}" RowHeight="28" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="类型" Binding="{Binding LocTypeText}" Width="64" MinWidth="56"/>
                                        <DataGridTextColumn Header="RCS编码" Binding="{Binding RcsCode}" Width="110" MinWidth="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                                    <Setter Property="ToolTip" Value="{Binding RcsCode}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="点位类型" Binding="{Binding RcsTypeText}" Width="72" MinWidth="64"/>
                                        <DataGridTextColumn Header="名称" Binding="{Binding LocNameText}" Width="*" MinWidth="80"/>
                                        <DataGridTextColumn Header="机台" Binding="{Binding EquipmentText}" Width="100" MinWidth="72"/>
                                        <DataGridTextColumn Header="工位" Binding="{Binding PositionText}" Width="90" MinWidth="64"/>
                                        <DataGridTextColumn Header="料架" Binding="{Binding FrameText}" Width="110" MinWidth="72"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="录入 / 编辑" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock Text="按逻辑类型只显示相关字段；保存时校验必填关联。"
                                                   Style="{StaticResource MutedText}" FontSize="10" Opacity="0.85"
                                                   TextWrapping="Wrap" Margin="0,4,0,10"/>

                                        <TextBlock Text="逻辑类型" Style="{StaticResource MutedText}"/>
                                        <ComboBox ItemsSource="{Binding LocTypeOptions}" SelectedItem="{Binding LocType}"
                                                  Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" Margin="0,2,0,8"/>

                                        <TextBlock Text="RCS 编码" Style="{StaticResource MutedText}"/>
                                        <TextBox Text="{Binding LocRcsCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"
                                                 Margin="0,2,0,8" ToolTip="现场 RCS 点位号，如 601001"/>

                                        <TextBlock Text="点位类型" Style="{StaticResource MutedText}"/>
                                        <ComboBox ItemsSource="{Binding RcsTypeOptions}" SelectedItem="{Binding LocRcsType}"
                                                  Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" Margin="0,2,0,8"
                                                  ToolTip="站点=station / 仓位=cell / 料架站=shelf"/>

                                        <StackPanel Visibility="{Binding ShowLocAreaName, Converter={StaticResource BoolVisConv}}">
                                            <TextBlock Text="区域名称" Style="{StaticResource MutedText}"/>
                                            <ComboBox ItemsSource="{Binding AreaNameOptions}" SelectedItem="{Binding LocName}"
                                                      Style="{StaticResource FormCombo}" Foreground="{StaticResource FgBrush}" Margin="0,2,0,8"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ShowLocRemarkName, Converter={StaticResource BoolVisConv}}">
                                            <TextBlock Text="备注名（可选）" Style="{StaticResource MutedText}"/>
                                            <TextBox Text="{Binding LocName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormInput}" Margin="0,2,0,8"/>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding ShowLocEquipment, Converter={StaticResource BoolVisConv}}" Margin="0,0,0,8">
                                            <TextBlock Text="机台" Style="{StaticResource MutedText}"/>
                                            <ComboBox ItemsSource="{Binding LocEquipmentOptions}" SelectedItem="{Binding SelectedLocEquipment}"
                                                      DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                                                      Foreground="{StaticResource FgBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ShowLocPosition, Converter={StaticResource BoolVisConv}}" Margin="0,0,0,8">
                                            <TextBlock Text="工位" Style="{StaticResource MutedText}"/>
                                            <ComboBox ItemsSource="{Binding LocPositionOptions}" SelectedItem="{Binding SelectedLocPosition}"
                                                      DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                                                      Foreground="{StaticResource FgBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ShowLocFrame, Converter={StaticResource BoolVisConv}}" Margin="0,0,0,8">
                                            <TextBlock Text="料架" Style="{StaticResource MutedText}"/>
                                            <ComboBox ItemsSource="{Binding LocFrameOptions}" SelectedItem="{Binding SelectedLocFrame}"
                                                      DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                                                      Foreground="{StaticResource FgBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="新建" Style="{StaticResource GhostButton}" Height="28" Padding="14,0"
                                                    Command="{Binding NewLocationCommand}"/>
                                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Height="28" Padding="14,0"
                                                    Margin="8,0,0,0" Command="{Binding SaveLocationCommand}"/>
                                            <Button Content="删除" Style="{StaticResource DangerButton}" Height="28" Padding="14,0"
                                                    Margin="8,0,0,0" Command="{Binding DeleteLocationCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Height="24">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
