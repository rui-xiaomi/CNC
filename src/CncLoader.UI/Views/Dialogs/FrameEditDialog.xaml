<Window x:Class="CncLoader.UI.Views.Dialogs.FrameEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增料架" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource FontSans}">
    <Border Style="{StaticResource Panel}" Margin="12">
        <StackPanel Margin="16">
            <TextBlock x:Name="HeaderText" Text="新增料架" Style="{StaticResource PanelTitle}" FontSize="15" Margin="0,0,0,4"/>
            <TextBlock x:Name="HintText" Text="保存时按 层 × 每层槽数 预建空槽位（允许初始不放满）。" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock Text="料架名称" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FormInput}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="料架编码" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox x:Name="CodeBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock Text="识别码" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                <TextBox x:Name="IdentifyBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="层数" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox x:Name="LayerBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}" Text="10"/>
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="每层槽数" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox x:Name="PerLayerBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}" Text="2"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="84" Click="OnSave"/>
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
