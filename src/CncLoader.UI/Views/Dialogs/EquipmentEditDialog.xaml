<Window x:Class="CncLoader.UI.Views.Dialogs.EquipmentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增机台" Height="Auto" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource FontSans}">
    <Border Style="{StaticResource Panel}" Margin="12">
        <StackPanel Margin="16">
            <TextBlock Text="新增机台" Style="{StaticResource PanelTitle}" FontSize="15" Margin="0,0,0,4"/>
            <TextBlock Text="保存时自动创建 2 个加工位并绑定独立 PLC。" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock Text="所属工序" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                <ComboBox x:Name="CraftCombo" Grid.Column="1" DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="机台编号" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox x:Name="NoBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock Text="机台名称" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/></StackPanel>
                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FormInput}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="机台编码" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox x:Name="CodeBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="机台类型" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox x:Name="TypeBox" Grid.Column="1" Style="{StaticResource FormInput}" Text="检测"/>
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="关联 PLC" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="PlcCombo" Grid.Column="1" DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="84" Click="OnSave"/>
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
