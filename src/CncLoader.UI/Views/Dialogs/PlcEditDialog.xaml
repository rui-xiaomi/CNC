<Window x:Class="CncLoader.UI.Views.Dialogs.PlcEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC 配置" Height="Auto" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource FontSans}">
    <Border Style="{StaticResource Panel}" Margin="12">
        <StackPanel Margin="16">
            <TextBlock x:Name="TitleText" Text="新增 PLC" Style="{StaticResource PanelTitle}" FontSize="15" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubtitleText" Text="一机一 PLC，IP 各异；PlcId 为业务键，被机台/点位引用。"
                       Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="对应机台" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="EquipmentCombo" Grid.Column="1"
                          DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"
                          Foreground="{StaticResource FgBrush}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PLC 编号" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PlcIdBox" Grid.Column="0" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
                    <TextBlock x:Name="PlcIdHint" Grid.Column="1" Text="" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PLC 名称" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FormInput}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IP 地址" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock Text="*" Foreground="{StaticResource AlarmBrush}" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="IpBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="端口" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource FormInput}" FontFamily="{StaticResource FontMono}"/>
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="协议" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="ProtocolCombo" Grid.Column="1" Style="{StaticResource FormCombo}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="84" Click="OnSave"/>
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
