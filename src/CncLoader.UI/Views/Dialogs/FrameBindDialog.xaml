<Window x:Class="CncLoader.UI.Views.Dialogs.FrameBindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置关联料架" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource FontSans}">
    <Border Style="{StaticResource Panel}" Margin="12">
        <StackPanel Margin="16">
            <TextBlock x:Name="HeaderText" Text="配置关联料架" Style="{StaticResource PanelTitle}" FontSize="15" Margin="0,0,0,4"/>
            <TextBlock Text="为该机台指定上料架 / 下料架（支持一架两用，可选「无」清除）。" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="上料架" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="UploadCombo" Grid.Column="1" DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"/>
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="下料架" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="DownloadCombo" Grid.Column="1" DisplayMemberPath="DisplayName" Style="{StaticResource FormCombo}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="84" Click="OnSave"/>
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
