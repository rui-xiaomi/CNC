<Window x:Class="CncLoader.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:CncLoader.UI.Converters"
        xmlns:vm="clr-namespace:CncLoader.UI.ViewModels"
        Title="CNC 自动化上下料客户端" Height="820" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource FontSans}" FontSize="13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StringToGeometryConverter x:Key="GeometryConv"/>
        <CollectionViewSource x:Key="NavView" Source="{Binding NavItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Border BorderBrush="Black" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 chrome ===== -->
            <Grid Grid.Row="0" Background="{StaticResource ChromeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="CNC 自动化上下料客户端" Foreground="White"
                               FontFamily="{StaticResource FontCond}" FontWeight="SemiBold"/>
                    <TextBlock Text="v1.0" Foreground="{StaticResource ChromeFgDimBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource Chrome2Brush}" CornerRadius="3"
                        BorderBrush="#333A42" BorderThickness="1" Margin="12,6" Padding="8,2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="线体：" Foreground="{StaticResource ChromeFgBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WorkLineName}" Foreground="{StaticResource ChromeFgBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AlarmBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlcAllOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding PlcStatusText}" Foreground="White" FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="心跳" Foreground="{StaticResource ChromeFgBrush}" FontSize="12" Margin="14,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HeartbeatText}" Foreground="White" FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Width="40" Height="38" Click="OnMinimize" Style="{StaticResource ChromeButton}" Content="—"/>
                    <Button x:Name="MaxBtn" Width="40" Height="38" Click="OnMaximize" Style="{StaticResource ChromeButton}" Content="▢"/>
                    <Button x:Name="CloseBtn" Width="40" Height="38" Click="OnClose" Style="{StaticResource ChromeCloseButton}" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- ===== 主体 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧栏：扁平、分组、非树形 -->
                <Border Grid.Column="0" Background="{StaticResource ChromeBrush}" BorderBrush="Black" BorderThickness="0,0,1,0">
                    <ListBox x:Name="NavList"
                             ItemsSource="{Binding Source={StaticResource NavView}}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NavItemContainer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                          StrokeThickness="1.6" Fill="Transparent"
                                          Data="{Binding IconData, Converter={StaticResource GeometryConv}}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource ChromeFgDimBrush}"
                                                   FontFamily="{StaticResource FontCond}" FontSize="11" FontWeight="SemiBold"
                                                   Margin="14,10,14,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 状态条 -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="16,0">
                            <TextBlock Text="{Binding CurrentTitle}" FontFamily="{StaticResource FontCond}" FontWeight="SemiBold"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="PLC ModbusTCP" Style="{StaticResource MutedText}" Margin="0,0,18,0"/>
                                <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                           Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 页面路由：ContentControl（非 TreeView） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <ContentControl Content="{Binding CurrentPage}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
