<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CncLoader.UI\CncLoader.UI.csproj" />
    <ProjectReference Include="..\CncLoader.Core\CncLoader.Core.csproj" />
    <ProjectReference Include="..\CncLoader.Data\CncLoader.Data.csproj" />
    <ProjectReference Include="..\CncLoader.Communication\CncLoader.Communication.csproj" />
    <ProjectReference Include="..\CncLoader.Common\CncLoader.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
