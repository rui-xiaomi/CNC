<Application x:Class="CncLoader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- HandyControl 深色皮肤 + 主题（业务控件基线）。WPF-UI 待 FluentWindow/NavigationView 阶段按作用域引入。 -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <!-- 自研令牌/样式/页面模板：最后加载，覆盖库默认配色/圆角/字体 -->
                <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Tokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/DashboardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/CncLoader.UI;component/Theme/PageTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
